<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>
  {% unless page.url == '/' %}{{ page.title | escape }} | {% endunless %}
  {{ site.title | escape }}
</title>
<meta name="author" content="{{ site.title | escape }}">
<meta name="description" content="{{ page.description | default: site.description | strip | escape }}">
<meta name="keywords" content="{{ site.keywords | escape }}">
